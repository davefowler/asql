{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "asql/**",
      "Dockerfile",
      "pyproject.toml",
      "uv.lock",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "/bin/sh -c 'exec uvicorn asql.playground.app:app --host 0.0.0.0 --port \"$PORT\"'",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
