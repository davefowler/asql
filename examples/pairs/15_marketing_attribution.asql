-- Marketing attribution: First-touch and last-touch attribution
from marketing_touchpoints
  select 
    customer_id,
    campaign_id,
    touchpoint_date,
    row_number() over (partition by customer_id order by touchpoint_date asc) as rn
  qualify rn == 1
  stash as first_touch

from marketing_touchpoints
  select 
    customer_id,
    campaign_id,
    touchpoint_date,
    row_number() over (partition by customer_id order by touchpoint_date desc) as rn
  qualify rn == 1
  stash as last_touch

from campaigns
  &? first_touch on campaigns.campaign_id = first_touch.campaign_id
  &? last_touch on campaigns.campaign_id = last_touch.campaign_id
  &? orders on (orders.customer_id = first_touch.customer_id or orders.customer_id = last_touch.customer_id)
    and orders.status = "completed"
  group by campaigns.campaign_id, campaigns.campaign_name (
    count(distinct first_touch.customer_id) as first_touch_customers,
    count(distinct last_touch.customer_id) as last_touch_customers,
    sum(orders.total_amount) as attributed_revenue
  )
  order by -attributed_revenue

