-- Funnel analysis: Conversion rates through stages
from page_views
  where page == "product"
  select count(distinct user_id) as users, "viewed" as stage
  stash as viewed

from cart_items
  select count(distinct user_id) as users, "added_to_cart" as stage
  stash as added_to_cart

from checkout_sessions
  where status == "started"
  select count(distinct user_id) as users, "started_checkout" as stage
  stash as started_checkout

from orders
  where status == "completed"
  select count(distinct user_id) as users, "completed_purchase" as stage
  stash as completed_purchase

-- Note: Would need UNION ALL support and window functions for full implementation
from viewed
  union all from added_to_cart
  union all from started_checkout
  union all from completed_purchase

