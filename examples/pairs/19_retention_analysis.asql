-- Retention analysis: Monthly active users and retention
with monthly_users = from user_activities
  group by user_id, month(activity_date) (
    month(activity_date) as activity_month
  )

with user_first_month = from monthly_users
  group by user_id (
    min(activity_month) as first_month
  )

from monthly_users
  left join user_first_month on monthly_users.user_id == user_first_month.user_id
  group by monthly_users.activity_month (
    count(distinct monthly_users.user_id) as mau,
    count(distinct case when user_first_month.first_month == monthly_users.activity_month then monthly_users.user_id end) as new_users,
    count(distinct case when user_first_month.first_month < monthly_users.activity_month then monthly_users.user_id end) as returning_users,
    round(count(distinct case when user_first_month.first_month < monthly_users.activity_month then monthly_users.user_id end)::numeric 
      / nullif(count(distinct monthly_users.user_id), 0) * 100, 2) as retention_rate
  )
  order by -monthly_users.activity_month

