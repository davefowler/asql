-- CTE: Active users by country with their order totals
from users
  where status = 'active' and last_login_date >= current_date - interval '30 days'
  stash as active_users

from orders
  where status = 'completed'
  group by customer_id (
    count(*) as order_count,
    sum(total_amount) as lifetime_value
  )
  stash as user_orders

from active_users
  &? user_orders on active_users.user_id = user_orders.customer_id
  group by active_users.country (
    count(distinct active_users.user_id) as active_user_count,
    avg(coalesce(user_orders.order_count, 0)) as avg_orders_per_user,
    sum(coalesce(user_orders.lifetime_value, 0)) as total_lifetime_value
  )
  order by -active_user_count

