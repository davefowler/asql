        "name": null,
        "from": {
          "table": "users",
          "alias": null
        },
        "transforms": [
          {
            "id": "t0",
            "type": "select",
            "columns": [
              {"name": "name", "expression": "name"},
              {"name": "email", "expression": "email"},
              {"name": "country", "expression": "country"}
            ]
          }
        ]
      }
    ]
  },
  {
    "title": "Group and Count",
    "desc": "Count users by country",
    "dialect": "visual-asql",
    "query": [
      {
        "name": null,
        "from": {
          "table": "users",
          "alias": null
        },
        "transforms": [
          {
            "id": "t0",
            "type": "group_by",
            "dimensions": ["country"],
            "aggregates": [
              {"function": "count", "column": "*", "alias": "total"}
            ]
          }
        ]
      }
    ]
  },
  {
    "title": "Sort and Limit",
    "desc": "Get top 10 users alphabetically",
    "dialect": "visual-asql",
    "query": [
      {
        "name": null,
        "from": {
          "table": "users",
          "alias": null
        },
        "transforms": [
          {
            "id": "t0",
            "type": "select",
            "columns": [
